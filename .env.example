# ==============================================================================
# Khidmat (خدمت) Mobile App Environment Configuration Template
# ==============================================================================

# --- Supabase Backend Configuration ---
# Required for connecting to the PostgreSQL backend via Supabase.
EXPO_PUBLIC_SUPABASE_URL=https://sodxwchaqpqnwvnrnsaj.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_KYRYhqhTDJSohgptEx5GVg_GooKFAqw

# --- Development & Testing Flags ---
# Set to 'true' to use in-memory mock client instead of network calls (dev/test only)
EXPO_PUBLIC_USE_MOCK=false

# Set to 'true' to display the 1-Tap Quick Demo Login button (dev/test only)
EXPO_PUBLIC_ENABLE_DEMO=false

# Legacy mock toggle (mapped to USE_MOCK)
EXPO_PUBLIC_DEMO_MODE=false

# --- Agent Server Backend ---
# Host address of the autonomous AI agent server for intent parsing & recommendations
EXPO_PUBLIC_AGENT_SERVER_URL=http://localhost:8787

# --- Maps & Geolocation ---
# Optional Google Maps API key for native map tiles (react-native-maps)
EXPO_PUBLIC_GOOGLE_MAPS_API_KEY=

# --- Service Feature Flags ---
# Set to 'true' when server-side transactional email provider is configured
EXPO_PUBLIC_EMAIL_ENABLED=false

# Phone OTP SMS authentication (requires SMS gateway configured in Supabase Auth)
EXPO_PUBLIC_PHONE_AUTH_ENABLED=false

# Wallet / payments tracking feature flag
EXPO_PUBLIC_PAYMENTS_ENABLED=false

# Real-time background location updates during active jobs (Android foreground service)
EXPO_PUBLIC_BG_LOCATION_ENABLED=false

# --- Analytics (PostHog) ---
# Optional analytics key; leave blank for complete telemetry no-op
EXPO_PUBLIC_POSTHOG_KEY=
EXPO_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

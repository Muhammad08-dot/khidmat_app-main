EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=
EXPO_PUBLIC_AGENT_SERVER_URL=
# Set to 'true' only when a server-side email provider is wired up (client never sends email directly)
EXPO_PUBLIC_EMAIL_ENABLED=false

# --- Feature flags (all safe to leave 'false' until the backing service is configured) ---
# Phone OTP sign-in: also requires a Twilio (or other) SMS provider enabled in Supabase Auth.
EXPO_PUBLIC_PHONE_AUTH_ENABLED=false
# Wallet payments (JazzCash/EasyPaisa): requires PAYMENTS_ENABLED + GW_* creds on agent-server.
EXPO_PUBLIC_PAYMENTS_ENABLED=false
# Background provider tracking during in_progress jobs (sensitive permission; needs store-review copy).
EXPO_PUBLIC_BG_LOCATION_ENABLED=false
# Product analytics (PostHog). Leave key empty for a strict no-op; never add PII to events.
EXPO_PUBLIC_POSTHOG_KEY=
EXPO_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

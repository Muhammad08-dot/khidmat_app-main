{
  "name": "khidmat-agent-server",
  "private": true,
  "version": "1.0.0",
  "description": "Khidmat Self-Healing Agent Server — receives crash reports and returns AI diagnosis",
  "main": "src/index.ts",
  "type": "module",
  "scripts": {
    "start": "tsx src/index.ts",
    "dev": "tsx watch src/index.ts",
    "build": "tsc src/index.ts --outDir dist --esModuleInterop --skipLibCheck",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@langchain/core": "0.3.80",
    "@langchain/google-genai": "0.1.12",
    "@langchain/openai": "0.3.17",
    "@supabase/supabase-js": "^2.117.2",
    "cors": "^2.8.6",
    "dotenv": "16.6.1",
    "express": "4.22.2",
    "express-rate-limit": "^8.7.1",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^22.10.0",
    "tsx": "4.23.13",
    "typescript": "~5.7.0"
  }
}
